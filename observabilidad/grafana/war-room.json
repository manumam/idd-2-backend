      "targets": [
        {
          "expr": "100 * sum(increase(api_http_requests_total{entorno=\"$entorno\",ruta!=\"sin_ruta\",status!~\"5..\"}[14d])) / sum(increase(api_http_requests_total{entorno=\"$entorno\",ruta!=\"sin_ruta\"}[14d]))",
          "instant": true,
          "refId": "A"
