# ==============================================================================
# FIXTURE 2030 - CONFIGURACIÓN DE ENTORNO LOCAL
# ==============================================================================
# Copia este archivo a .env y ajusta los valores según tu configuración local.
# IMPORTANTE: Nunca agregues contraseñas reales ni subas el archivo .env a Git.

# --- Configuración General de la API ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
DB_TIMEOUT_SECONDS=5.0

# --- MongoDB (Módulo Documental: Equipos y Jugadores) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=fixture2030

# --- Neo4j (Módulo de Grafos: Partidos y Eventos) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Cassandra (Módulo Tabular: Comentarios) ---
CASSANDRA_HOSTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_LOCAL_DC=datacenter1
CASSANDRA_KEYSPACE=fixture2030_comentarios

# --- Redis (Módulo Clave/Valor: Sesiones y Caché) ---
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=

# --- InfluxDB 3 (Módulo Temporal: Estadísticas de Partidos) ---
INFLUX_URL=http://127.0.0.1:8181
INFLUX_DATABASE=fixture2030_resumen
INFLUX_TOKEN=

# --- InterSystems IRIS (Módulo Objetos Persistentes: Dominio Complejo) ---
IRIS_HOST=127.0.0.1
IRIS_PORT=1972
IRIS_NAMESPACE=USER
IRIS_USER=_SYSTEM
IRIS_PASSWORD=
